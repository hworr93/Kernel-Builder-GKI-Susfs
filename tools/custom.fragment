Here’s the cleaned version with all exact duplicates removed (kept the first occurrence of each). I also removed the conflicting `CONFIG_DEFAULT_BBR=y` so that `CONFIG_DEFAULT_TCP_CONG="bbr3"` remains the only default.

# tools/custom.fragment
# ==============================================================================
# CUSTOM ADVANCED CONFIGS
# Instructions: Uncomment (remove the '# ') to enable a specific configuration.
# ==============================================================================

# --- CORE WIREGUARD ---
CONFIG_WIREGUARD=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y

# --- NETFILTER & IPTABLES UNLOCKERS ---
CONFIG_NETFILTER_ADVANCED=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_NETFILTER_XT_MATCH_HL=y

# --- LATENCY & THROUGHPUT OPTIMIZATIONS ---
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR3=y

# --- QUEUING & SCHEDULERS ---
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# --- VIRTUAL NETWORKS & NOMOUNT ---
CONFIG_DUMMY=y
CONFIG_NOMOUNT=y


# =============================================================================
# Performance-tuned + Droidspaces support
# For Pixel 10 (Tensor G5 / muzel / android15-6.6 GKI family)
# Higher responsiveness & sustained performance (more power draw / heat)
# =============================================================================

# ----- Droidspaces (GKI-safe set – REQUIRES the kABI SYSVIPC patch) -----
#CONFIG_SYSVIPC=y
#CONFIG_POSIX_MQUEUE=y
#CONFIG_IPC_NS=y
#CONFIG_PID_NS=y
#CONFIG_DEVTMPFS=y
#CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Strongly recommended for Docker / desktop environments inside containers
CONFIG_USER_NS=y

# Extra networking (UFW / Fail2ban / better NAT)
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# ----- CPU Frequency / Scheduler (performance biased) -----
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y   # still schedutil, but you can force PERFORMANCE at runtime
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y         # available for max performance mode
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y

# Prefer more aggressive scaling behavior (runtime tunables will matter a lot)
# These just ensure the governors and features are present

# ----- Power / Idle (less aggressive power saving) -----
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_CPU_IDLE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
# Note: We keep idle support, but runtime governor/uclamp settings should favor performance

# ----- Memory (favor responsiveness) -----
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
# Optional: if you want even lower latency at cost of RAM
# CONFIG_ZRAM_WRITEBACK is not set

# ----- I/O (low latency preference) -----
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
# CONFIG_IOSCHED_BFQ is not set          # avoid BFQ for lower overhead

# ----- Networking (maximum throughput) -----
#CONFIG_DEFAULT_TCP_CONG="bbr3"           # prefer BBR3 when available
#CONFIG_TCP_CONG_WESTWOOD=y
#CONFIG_IP_SET_MAX=65534
#CONFIG_IP_SET_BITMAP_IP=y
#CONFIG_IP_SET_BITMAP_IPMAC=y
#CONFIG_IP_SET_BITMAP_PORT=y
#CONFIG_IP_SET_HASH_IPMARK=y
#CONFIG_IP_SET_HASH_IPPORT=y
#CONFIG_IP_SET_HASH_IPPORTIP=y
#CONFIG_IP_SET_HASH_IPPORTNET=y
#CONFIG_IP_SET_HASH_IPMAC=y
#CONFIG_IP_SET_HASH_MAC=y
#CONFIG_IP_SET_HASH_NETPORTNET=y
#CONFIG_IP_SET_HASH_NETNET=y
#CONFIG_IP_SET_HASH_NETPORT=y
#CONFIG_IP_SET_HASH_NETIFACE=y
#CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_NET_ACT_CONNMARK=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_IP6_NF_MATCH_HL=y

# ----- Useful extra features -----
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y

# Container / nested virtualization friendly
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# eBPF (useful for advanced networking / observability)
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# ----- Aggressively disable debug / sanitizers (max performance) -----
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_STACKTRACE is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_LOCKDEP is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_UBSAN is not set
# CONFIG_KCOV is not set
# CONFIG_GCOV_KERNEL is not set